# Copy to .env and fill in. .env is gitignored and must never be committed.

APP_NAME=base_api
APP_TITLE=Basic fastAPI API implementation

HOST=127.0.0.1

API_PORT=8091
API_NAME=BaseAPI
API_LOG=base-api.log


# Database the app uses; db/schema/sql/02-create-database.sql creates this name.
DB_NAME=base_api

# Password shared by the plh, root and api Postgres roles.
DB_PASSWORD=

# Host port the dev Postgres publishes (docker/db/docker-compose.yml).
# Both compose stacks interpolate these, so this file is the single place
# the ports are chosen; pick anything free if the defaults clash locally.
DB_PORT=5432

# Host port the test Postgres publishes (docker/test/docker-compose.yml).
# Deliberately a different name from DB_PORT: the test suite reads only the
# TEST_* keys, so pointing DB_PORT at dev can never redirect the tests.
TEST_DB_PORT=5433

# Which deployment this is: dev, test, staging or prod.
# Stamped into instance_metadata, which the front end reads.
RELEASE=dev

# Token signing.  No default: the application refuses to issue or verify a
# token while this is unset.  HS256 requires at least 32 bytes.  Generate one:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
